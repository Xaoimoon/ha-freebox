{
  "entity": {
    "binary_sensor": {
      "connection": {
        "default": "mdi:web",
        "state": {
          "off": "mdi:web-off"
        }
      },
      "ftth_signal": {
        "default": "mdi:signal-variant",
        "state": {
          "off": "mdi:signal-off"
        }
      }
    },
    "button": {
      "mark_calls_as_read": {
        "default": "mdi:phone-check"
      },
      "resume_schedule": {
        "default": "mdi:calendar-sync"
      }
    },
    "sensor": {
      "access_mode": {
        "default": "mdi:shield-account",
        "state": {
          "denied": "mdi:shield-lock",
          "allowed": "mdi:shield-check"
        }
      },
      "bytes_down": {
        "default": "mdi:download"
      },
      "bytes_up": {
        "default": "mdi:upload"
      },
      "connected_devices": {
        "default": "mdi:devices"
      },
      "fan_speed": {
        "default": "mdi:fan"
      },
      "last_outage": {
        "default": "mdi:web-cancel"
      },
      "missed": {
        "default": "mdi:phone-missed"
      },
      "next_change": {
        "default": "mdi:clock-outline"
      },
      "partition_free_space": {
        "default": "mdi:harddisk"
      },
      "rate_down": {
        "default": "mdi:download-network"
      },
      "rate_up": {
        "default": "mdi:upload-network"
      },
      "sfp_pwr_rx": {
        "default": "mdi:arrow-down-bold-circle-outline"
      },
      "sfp_pwr_tx": {
        "default": "mdi:arrow-up-bold-circle-outline"
      }
    },
    "switch": {
      "internet_access": {
        "default": "mdi:web",
        "state": {
          "off": "mdi:web-off"
        }
      },
      "wifi": {
        "default": "mdi:wifi",
        "state": {
          "off": "mdi:wifi-off"
        }
      }
    }
  },
  "services": {
    "block_internet": {
      "service": "mdi:web-off"
    },
    "allow_internet": {
      "service": "mdi:web"
    },
    "resume_schedule": {
      "service": "mdi:calendar-sync"
    }
  }
}
